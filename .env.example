# Written automatically the first time you run `npx convex dev`.
VITE_CONVEX_URL=

# Optional: set to "true" to validate numbers via the real Numverify
# API (called securely from convex/numverify.ts) instead of the local
# heuristic validator. Requires NUMVERIFY_API_KEY to be set in your
# Convex dashboard's environment variables.
VITE_USE_CONVEX_VALIDATION=false
